# JAMI AI Environment Configuration
NODE_ENV=development
APP_MODE=production
PORT=3000
APP_BASE_URL=http://localhost:3000

# Authentication & Session Security (Minimum 32 random characters for production)
SESSION_SECRET=jami_ai_super_secret_production_key_32_characters_long
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CORS_ALLOWED_ORIGINS=
VITE_API_BASE_URL=

# Aiven MySQL Database Configuration
AIVEN_MYSQL_HOST=
AIVEN_MYSQL_PORT=3306
AIVEN_MYSQL_DATABASE=defaultdb
AIVEN_APP_USER=
AIVEN_APP_PASSWORD=
AIVEN_CA_CERT=

# OpenAI API Configuration (Server-Side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
