# JAMI AI Environment Configuration
NODE_ENV=development
APP_MODE=demo
PORT=3000
APP_BASE_URL=http://localhost:3000

# Authentication & Session Security (Minimum 32 random characters for production)
SESSION_SECRET=your_32_character_minimum_random_session_secret_key_here
ADMIN_SECRET_KEY=your_admin_secret_key_here
INTERNAL_CRON_SECRET=your_internal_cron_shared_secret_key_here
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
VITE_API_BASE_URL=/api/v1

# Aiven MySQL Database Configuration
AIVEN_MYSQL_HOST=
AIVEN_MYSQL_PORT=3306
AIVEN_MYSQL_DATABASE=defaultdb
AIVEN_APP_USER=
AIVEN_APP_PASSWORD=
AIVEN_CA_CERT=
AIVEN_CA_CERT_PATH=

# Password Reset & Email Configuration (Set PASSWORD_RESET_ENABLED=true when SMTP is configured)
PASSWORD_RESET_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@jami.edu.vn

# OpenAI API Configuration (Server-Side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_VOICE=alloy

# Cloudflare R2 Object Storage (S3-Compatible Credentials)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=jami-materials
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=

