# Environment Configuration Template for JAMI AI
# Copy this file to .env and adjust values for your environment.
# DO NOT commit real secrets or credentials into version control.

NODE_ENV=development
PORT=3000
APP_MODE=demo
APP_BASE_URL=http://localhost:3000

# MySQL Database Configuration (Optional in demo mode)
AIVEN_MYSQL_HOST=
AIVEN_MYSQL_PORT=3306
AIVEN_APP_USER=
AIVEN_APP_PASSWORD=
AIVEN_MYSQL_DATABASE=defaultdb
AIVEN_CA_CERT=

# Security & Sessions
SESSION_SECRET=change-this-to-a-secure-random-string-at-least-32-characters
INTERNAL_CRON_SECRET=change-this-to-a-secure-internal-cron-secret-32-chars
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
DEMO_LOGIN_ENABLED=true

# OpenAI API Key & Model Options (Optional in demo mode)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_VOICE=alloy

# Cloudflare R2 / S3 Object Storage (Optional in demo mode)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=jami-materials
R2_ENDPOINT=
R2_PUBLIC_URL=

# Soft Books (Sách Mềm) Limits & AI Quotas
BOOK_MAX_UPLOAD_MB=100
BOOK_STORAGE_QUOTA_MB=1000
BOOK_MAX_PAGES=1500
AI_DAILY_QUOTA=100
AI_MAX_CONCURRENCY_PER_USER=3
